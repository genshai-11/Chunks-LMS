# =========================================================================
# Chunks-LMS Environment Variables
# Copy this file to web/.env and configure the variables.
# =========================================================================

# Option A: Local Supabase (run `supabase start` in root to get these)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Option B: Hosted Supabase (from Supabase dashboard settings -> API)
# VITE_SUPABASE_URL=https://ekubetkxfcuxlyahesrl.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Authentication Bypass (Local/CI development only)
# Set to true to automatically grant Admin+Teacher access without signing in
VITE_AUTH_BYPASS=false
